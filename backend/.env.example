# Ytalks backend — environment variables
#
# Copy to `.env` for reference. Spring Boot does not read this file
# automatically; export the variables in your shell, or set them in your IDE
# run configuration. Every value below has a working default in
# src/main/resources/application.yml, so the backend starts with none of them.

# HTTP port the API listens on.
YTALKS_PORT=8080

# Comma-separated frontend origins allowed to call /api/**. No wildcard is used.
YTALKS_CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Send cookies/Authorization on cross-origin calls.
YTALKS_CORS_ALLOW_CREDENTIALS=true

# Backend log level: ERROR, WARN, INFO, DEBUG, TRACE
YTALKS_LOG_LEVEL=INFO

# Hibernate SQL logging (set to DEBUG to see SQL)
YTALKS_HIBERNATE_SQL_LOG=WARN

# Spring Security logging
YTALKS_SECURITY_LOG_LEVEL=INFO

# ---- MySQL Database (Milestone 3) -----------------------------------------
# The backend will create the database if it doesn't exist (createDatabaseIfNotExist=true).
# Change the password before running in production!
YTALKS_DB_HOST=localhost
YTALKS_DB_PORT=3306
YTALKS_DB_NAME=ytalks
YTALKS_DB_USERNAME=root
YTALKS_DB_PASSWORD=change_me

# ---- JWT Authentication (Milestone 4) -------------------------------------
# IMPORTANT: Change this secret in production! Use a long random string (64+ chars).
# Generate with: openssl rand -base64 48
YTALKS_JWT_SECRET=change-me-in-production-use-a-long-random-string-at-least-32-chars

# JWT token expiration in milliseconds (default: 24 hours = 86400000)
YTALKS_JWT_EXPIRATION_MS=86400000

# ---- OTP Configuration (Milestone 4) --------------------------------------
# Development mode: logs OTP to console instead of sending email (default: true)
YTALKS_OTP_DEV_MODE=true

# Enable real email delivery (requires email provider configuration)
YTALKS_OTP_EMAIL_ENABLED=false

# ---- Google Gemini AI Provider (Milestone 5) ------------------------------
# Get your API key from https://aistudio.google.com/app/apikey
# Never commit real API keys!
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (default: gemini-1.5-flash)
# Available: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Request timeout in milliseconds (default: 30000 = 30 seconds)
GEMINI_TIMEOUT_MS=30000

# ---- Not used yet ---------------------------------------------------------
# No other API keys and no AI provider settings exist in Milestone 5.
# Add them here when the milestone that needs them lands, and
# never commit real values.
